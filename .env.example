# WealthPilot configuration. Copy to .env next to docker-compose.yml to override defaults.
# Every value below is a safe placeholder or the built-in default. Never commit a real .env.
#
# Docker Compose reads this file for variable substitution. A local (non-Docker) run also reads it
# through the application settings. Precedence there: .env (non-blank value) > shell environment > default.
# A blank value counts as unset, so an empty key here does not mask a key exported in the shell.

# --- Model service (required) ---------------------------------------------------------------
# NVIDIA NIM API key from build.nvidia.com. NVIDIA_NIM_API_KEY is accepted as an alternative name.
NVIDIA_API_KEY=

# Models. The defaults are the ones every reported experiment used. Check availability for your account.
CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
CHAT_FALLBACK_MODEL=
VLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
EMBED_MODEL=nomic-embed-text

# --- Gateway behaviour ----------------------------------------------------------------------
NIM_RPM_BUDGET=15
NIM_CACHE_ENABLED=true
NIM_TIMEOUT_S=45
NIM_THINKING=false
# Fault injection for resilience tests only, for example {"p_429": 0.3}. Leave empty in normal use.
WP_CHAOS=

# --- Deployment -----------------------------------------------------------------------------
# Change the password before the first start; it is stored in the database volume.
POSTGRES_USER=wealthpilot
POSTGRES_PASSWORD=wealthpilot
POSTGRES_DB=wealthpilot
POSTGRES_PORT=5432
CONSOLE_PORT=8501
# 1 adds a "Try a sample applicant" tab. Needs demonstration data (make demo-data).
WEALTHPILOT_DEMO=0

# --- Local (non-Docker) runs only; Compose sets these itself --------------------------------
DATABASE_URL=postgresql://wealthpilot:wealthpilot@127.0.0.1:5432/wealthpilot
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
