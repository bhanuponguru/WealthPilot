# Copy to .env only if you want to override your shell environment.
# Precedence: .env (non-blank) > global environment > error.
# The NIM key may be named NVIDIA_API_KEY or NVIDIA_NIM_API_KEY, in either place.
# Leave blank (or omit) to use the one already exported in your shell.
NVIDIA_API_KEY=

POSTGRES_USER=wealthpilot
POSTGRES_PASSWORD=wealthpilot
DATABASE_URL=postgresql://wealthpilot:wealthpilot@127.0.0.1:5432/wealthpilot

MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Shared NIM budget across ALL processes (free tier is reportedly ~40 RPM per key)
NIM_RPM_BUDGET=15
